# ============================================================
# Smart Climate Engine – Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ---- App ----
APP_ENV=development             # development | production

# ---- PostgreSQL + PostGIS ----
POSTGRES_DB=climate_db
POSTGRES_USER=climate_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_PORT=5433
DATABASE_URL=postgresql://climate_user:change_me_in_production@localhost:5432/climate_db

# ---- Redis ----
REDIS_PASSWORD=change_me_in_production
REDIS_PORT=6379
REDIS_URL=redis://:change_me_in_production@localhost:6379/0

# ---- ML Service (FastAPI · Python) ----
ML_SERVICE_PORT=8000
ML_SERVICE_URL=http://localhost:8000

# ---- API Gateway (Express · Node.js) ----
API_PORT=4000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ---- Web App (Next.js) ----
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_ML_SERVICE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="Smart Climate Engine"

# ---- Nugen AI ----
NUGEN_API_KEY=your_nugen_api_key_here
NUGEN_BASE_URL=https://api.nugen.ai

# ---- Mapbox (frontend maps) ----
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here
