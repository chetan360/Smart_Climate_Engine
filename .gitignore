# ============================================================
# Smart Climate Engine – Monorepo .gitignore
# ============================================================

# ---- Node / JavaScript / TypeScript ----
node_modules/
.pnpm-store/
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# Build outputs
dist/
build/
out/
.next/
.turbo/
*.tsbuildinfo

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
env/
venv/
.eggs/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml

# ---- Environment / Secrets ----
.env
.env.local
.env.*.local
*.pem
*.key

# ---- Logs ----
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Docker local volumes ----
.docker-volumes/

# ---- OS files ----
.DS_Store
Thumbs.db
desktop.ini

# ---- IDE / Editor ----
.vscode/
.idea/
*.swp
*.swo
*.sublime-workspace

# ---- Temp / scratch ----
temp.txt
tmp.json
*.tmp
scratch/
